FLASK_APP=run.py
FLASK_DEBUG=true
SECRET_KEY=cambiar-en-produccion
JWT_SECRET_KEY=dev-only-jwt-secret-change-me-1234567890
JWT_ACCESS_TOKEN_HOURS=8

# PostgreSQL local (docker compose). Usa el rol de mínimo privilegio.
DATABASE_URL=postgresql+psycopg://sosnet_api:sosnet_api_dev@127.0.0.1:5432/sosnet
AUTO_CREATE_TABLES=false

CORS_ORIGINS=http://localhost:1010,http://localhost:5173
RATELIMIT_ENABLED=true
SOS_RETENTION_DAYS=90
